{
	"name": "pl_incload",
	"properties": {
		"activities": [
			{
				"name": "Fetching Tablelist",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select * from edu.tablelist",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azure_database_tablelist",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Filter loadtyepe full",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Fetching Tablelist",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Fetching Tablelist').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().loadtype,'inc')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Execute pl_incload",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Filter loadtyepe full",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_incload_foreach",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"filenames": {
							"value": "@activity('Filter loadtyepe full').output.value",
							"type": "Expression"
						}
					}
				}
			}
		],
		"annotations": []
	}
}